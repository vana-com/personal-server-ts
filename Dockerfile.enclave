# Prebuilt fleet enclave image: one image serves both the worker agent
# (packages/enclave/dist/agent/main.js) and the controller
# (packages/enclave/dist/central/main.js). Baking node_modules and dist here
# removes the per-boot `npm ci` (~32 s) and `tsc --build` (~44 s) that the CVM
# composes used to run on every start.

# ---------- build stage ----------
FROM node:22-alpine AS build

# build-base provides gcc/g++/make for the better-sqlite3 native addon
RUN apk add --no-cache build-base python3

WORKDIR /app

# Copy dependency manifests first for layer caching
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/lite/package.json packages/lite/
COPY packages/server/package.json packages/server/
COPY packages/cli/package.json packages/cli/
COPY packages/enclave/package.json packages/enclave/

RUN npm ci

COPY tsconfig.base.json ./
COPY packages/ packages/

# `tsc --build` follows the enclave's project references, so this also emits
# the core, lite, and server dist trees the enclave imports at runtime.
RUN npm run build -w @opendatalabs/personal-server-ts-enclave

# Reinstall without dev dependencies. Lifecycle scripts are skipped because the
# root `prepare` runs husky, a dev dependency; the better-sqlite3 addon that
# npm ci already built is carried across instead. Sources are dead once dist
# exists.
RUN cp -R node_modules/better-sqlite3/build /tmp/better-sqlite3-build \
  && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
  && cp -R /tmp/better-sqlite3-build node_modules/better-sqlite3/build \
  && rm -rf /tmp/better-sqlite3-build packages/*/src packages/*/tsconfig.tsbuildinfo

# ---------- runtime stage ----------
FROM node:22-alpine

# libstdc++ backs better-sqlite3; docker-cli drives the nested sandbox runtime
# over tcp://sandbox-runtime:2375; util-linux provides the controller's flock.
RUN apk add --no-cache libstdc++ docker-cli util-linux

WORKDIR /app

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules/ node_modules/
COPY --from=build /app/packages/ packages/

# The compose command overrides this to select the agent or controller role.
CMD ["node", "packages/enclave/dist/agent/main.js"]
