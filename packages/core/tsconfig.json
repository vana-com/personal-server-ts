{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // The eval harness is test scaffolding, not part of the published surface:
  // it is excluded from the build and has no `exports` entry. It is still
  // typechecked by `tsconfig.typecheck-tests.json` and still run by vitest;
  // `scripts/` reach it by relative path into `src/`.
  // No `files` override. It used to force-emit `evals/types.ts`,
  // `evals/readings.ts` and `evals/fixtures/profiles.ts` past this `exclude`,
  // because `query/agent/answerer.ts` type-imported `EvalAnswerer` and the
  // published `./query/agent` types would otherwise dangle. That adapter has
  // moved to `query/evals/agent-answerer.ts` — it never had a product
  // consumer — so nothing product code reaches imports `evals/` any more and
  // the exclude can do its whole job.
  "exclude": ["src/**/*.test.ts", "src/query/evals/**"]
}
