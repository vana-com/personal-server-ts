{
  "version": 1,
  "contract": "decideScopeDeletion({status, receipt, scope}) in packages/core/src/api/scope-delete-verdict.ts",
  "doc": "`receipt` is the delete answer's JSON body as read (the receipt, or an error answer attaching it as error.details.result); `status` is its HTTP status. `verdict` is what every host must answer.",
  "cases": [
    {
      "id": "happy-path",
      "why": "Every step ok on a 200.",
      "scope": "spotify.savedTracks",
      "status": 200,
      "receipt": {
        "scope": "spotify.savedTracks",
        "dataPointId": "0xabc",
        "durable": true,
        "pendingBlobDeletion": false,
        "steps": {
          "gateway": {
            "status": "ok"
          },
          "storage": {
            "status": "ok"
          },
          "local": {
            "status": "ok",
            "deletedCount": 1
          }
        }
      },
      "verdict": {
        "kind": "durably-deleted"
      }
    },
    {
      "id": "gateway-not-registered",
      "why": "A scope the gateway never held has nothing to tombstone.",
