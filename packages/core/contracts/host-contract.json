        "status": 409
      }
    ],
    "endResults": [
      "queued",
      "checkpoint_only",
      "no_checkpoint",
      "discarded",
      "aborted"
    ],
    "endOutcomes": [
      "succeeded",
      "partial",
      "retry_pending",
      "failed",
      "cancelled"
    ],
    "endAcceptance": [
      {
        "result": "queued",
        "outcomes": ["succeeded", "partial", "retry_pending"],
        "recordsSent": "any"
      },
      {
        "result": "checkpoint_only",
        "outcomes": ["retry_pending"],
        "recordsSent": "any"
      },
      {
        "result": "checkpoint_only",
        "outcomes": ["succeeded"],
        "recordsSent": "none"
      },
      {
        "result": "no_checkpoint",
        "outcomes": ["retry_pending"],
        "recordsSent": "any"
      },
      {
        "result": "no_checkpoint",
        "outcomes": ["succeeded"],
        "recordsSent": "none"
      }
    ]
  },
  "localDatabase": {
    "namePattern": "^vana-[A-Za-z0-9:/._-]+-[0-9a-f]{32}$"
  }
