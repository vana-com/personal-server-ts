        "status": 409
      },
      {
        "name": "connection_stopped",
        "status": 409
      },
      {
        "name": "delete_pending",
        "status": 409
      },
      {
        "name": "gone",
        "status": 410
      },
      {
        "name": "run_conflict",
        "status": 409
      },
      {
        "name": "unknown_artifact",
        "status": 422
      },
      {
        "name": "batch_gap",
        "status": 409
      },
      {
        "name": "restricted_scope_unsupported",
        "status": 422
      },
      {
        "name": "control_basis_mismatch",
        "status": 409
