{
  "version": 1,
  "contract": "Whether a stream-sync run's work is saved (decideRunSaved). receipt_or_status: a Web write's saved. strict_receipt: retiring old copies; a status alone never retires.",
  "cases": [
    {
      "id": "receipt_or_status-receipt-covers-run",
      "why": "A sound receipt that lists the run covers it.",
      "input": {
        "runId": "run-1",
        "connector": "c",
        "requiredStreams": ["items"],
        "receipts": [
          {
            "connectionId": "c~",
            "connector": "c",
            "ns": "",
            "stream": "items",
            "head": {
              "version": 3,
              "generation": 2,
              "dataHash": "ab12"
            },
            "watermark": 7,
            "runIds": ["run-1"]
          }
        ],
        "status": null,
        "liveConnections": ["c~"],
        "control": {
          "kind": "active",
          "generation": 2
        },
        "mode": "receipt_or_status"
      },
      "expect": {
        "saved": true,
        "proof": "receipt",
        "connectionId": "c~"
      }
    },
    {
      "id": "strict_receipt-receipt-covers-run",
      "why": "A sound receipt that lists the run covers it.",
