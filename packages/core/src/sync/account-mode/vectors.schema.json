{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vana-com/personal-server-ts/account-mode/vectors.schema.json",
  "title": "Account storage mode vectors",
  "description": "A list of event traces. A host runs each trace against its own copy of the account storage mode module and checks every expectation. A host that cannot read a field or an op in this schema must fail, not skip.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/vector" },
  "$defs": {
    "alias": {
      "description": "A short name for an owner address, resolved through the vector's owners map. The empty string stands for a missing owner.",
      "type": "string"
    },
    "clock": {
      "description": "Sets the monotonic clock (and the wall clock, which defaults to a fixed base plus monoMs).",
      "type": "object",
      "additionalProperties": false,
      "required": ["monoMs"],
      "properties": {
        "boot": { "type": "string" },
        "monoMs": { "type": "integer", "minimum": 0 },
        "wallMs": { "type": "integer", "minimum": 0 }
      }
    },
    "rawFixture": {
      "description": "What the host saw from the Account: explicit-off and explicit-on are a 200 with that state; malformed is a 200 with no usable state; timeout has no status.",
      "enum": [
        "explicit-off",
        "explicit-on",
        "http-401",
        "http-500",
        "http-503",
        "malformed",
        "timeout"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "op": {
          "enum": [
            "fetchStart",
            "accountResult",
            "admit",
            "read",
            "commit",
            "clock",
            "pauseDurableSave",
            "completeDurableSave",
            "failDurableSave",
            "importDone",
            "crash",
            "wipeDataDb"
          ]
        },
        "runtime": { "type": "string" },
        "clock": { "$ref": "#/$defs/clock" },
        "owner": { "$ref": "#/$defs/alias" },
        "authOwner": { "$ref": "#/$defs/alias" },
        "requestId": { "type": "string" },
        "rawFixture": { "$ref": "#/$defs/rawFixture" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "state"],
          "properties": {
            "owner": { "$ref": "#/$defs/alias" },
            "state": { "enum": ["on", "off", "unknown"] }
          }
        },
        "operationId": { "type": "string" },
        "sink": { "enum": ["legacy", "stream", "importSeed"] },
        "fail": { "type": "boolean" },
        "clockTrusted": { "type": "boolean" },
        "discardPausedSaves": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "fetchStart" } } },
          "then": { "required": ["requestId", "clock"] }
        },
        {
          "if": { "properties": { "op": { "const": "accountResult" } } },
          "then": {
            "required": ["authOwner", "requestId", "rawFixture", "evidence"]
          }
        },
        {
          "if": { "properties": { "op": { "const": "admit" } } },
          "then": { "required": ["owner", "operationId"] }
        },
        {
          "if": { "properties": { "op": { "const": "commit" } } },
          "then": { "required": ["owner", "operationId", "sink"] }
        },
        {
          "if": { "properties": { "op": { "const": "importDone" } } },
          "then": { "required": ["owner"] }
        },
        {
          "if": { "properties": { "op": { "const": "clock" } } },
          "then": { "required": ["clock"] }
        }
      ]
    },
    "expectation": {
      "description": "Checked right after the event named by 'after'. decision, code, status and importRequired are read from that event's answer, or from the event named by 'of'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["after"],
      "properties": {
        "after": { "type": "string", "minLength": 1 },
        "of": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["streams", "legacy", "refuse"] },
        "code": {
          "enum": [
            "ACCOUNT_MODE_UNKNOWN",
            "ACCOUNT_MODE_STORE_OWNED",
            "IMPORT_PENDING",
            "LEGACY_REFUSED_SWITCHED"
          ]
        },
        "status": { "enum": [426, 503] },
        "importRequired": { "type": "boolean" },
        "legacyMutations": { "type": "integer", "minimum": 0 },
        "durable": {
          "description": "Per owner alias: null (no stored record) or the stored fields that must match.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "switched": { "type": "boolean" },
                  "switchedAt": { "type": ["integer", "null"] },
                  "cleanOffAt": { "type": ["integer", "null"] },
                  "offFetchStartMono": { "type": ["integer", "null"] },
                  "bootId": { "type": ["string", "null"] },
                  "importPending": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "policy",
        "owners",
        "initial",
        "events",
        "expect"
      ],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offTtlMs"],
          "properties": { "offTtlMs": { "const": 604800000 } }
        },
        "owners": {
          "description": "Alias to owner address. Addresses compare lowercased.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "initial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "legacyFiles": {
              "description": "Aliases that have legacy files on disk when the vector starts.",
              "type": "array",
              "items": { "$ref": "#/$defs/alias" }
            },
            "runtimes": {
              "description": "Runtimes that share one record store. Default: one, named R1.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expectation" }
        }
      }
    }
  }
}
