{
  "version": 1,
  "id": "on-save-boundaries",
  "description": "While the On record is not yet durable (paused or failed save), no read, admission or commit is answered as On and no legacy write is authorized. A crash in that window leaves nothing durable. A later On answer retries the save.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": {},
  "events": [
    { "id": "p1", "op": "pauseDurableSave" },
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    { "id": "e2", "op": "read", "owner": "A" },
    { "id": "e3", "op": "admit", "owner": "A", "operationId": "w1" },
    {
      "id": "e4",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    },
    {
      "id": "e5",
      "op": "crash",
      "discardPausedSaves": true,
      "clock": { "boot": "b2", "monoMs": 0, "wallMs": 1000100 }
    },
    { "id": "e6", "op": "read", "owner": "A" },
    { "id": "x1", "op": "failDurableSave", "fail": true },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r2",
      "clock": { "boot": "b2", "monoMs": 10, "wallMs": 1000110 }
    },
    {
      "id": "e7",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r2",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    { "id": "e8", "op": "read", "owner": "A" },
    {
      "id": "e9",
      "op": "commit",
      "owner": "A",
      "operationId": "w2",
      "sink": "legacy"
    },
    { "id": "x2", "op": "failDurableSave", "fail": false },
    {
      "id": "f3",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r3",
      "clock": { "boot": "b2", "monoMs": 20, "wallMs": 1000120 }
    },
    {
      "id": "e10",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r3",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    { "id": "e11", "op": "read", "owner": "A" }
  ],
  "expect": [
    {
      "after": "e2",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503
    },
    {
      "after": "e3",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503
    },
    {
      "after": "e4",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503,
      "legacyMutations": 0,
      "durable": { "A": null }
    },
    {
      "after": "e6",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503,
      "durable": { "A": null }
    },
    {
      "after": "e8",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503
    },
    {
      "after": "e9",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503,
      "legacyMutations": 0,
      "durable": { "A": null }
    },
    {
      "after": "e10",
      "of": "e10",
      "decision": "streams",
      "durable": { "A": { "switched": true } }
    },
    { "after": "e11", "decision": "streams" }
  ]
}
