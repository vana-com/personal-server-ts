{
  "version": 1,
  "id": "two-runtimes-reject-stale-authorization",
  "description": "Two live runtimes share one durable record. The first latches On; the second, still holding a fresh Off in memory and an earlier admission, refuses the stale authorization, a swapped owner and a replayed operation at commit.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": { "runtimes": ["R1", "R2"] },
  "events": [
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "runtime": "R1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "A", "state": "off" }
    },
    {
      "id": "e2",
      "runtime": "R2",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "A", "state": "off" }
    },
    {
      "id": "e3",
      "runtime": "R2",
      "op": "admit",
      "owner": "A",
      "operationId": "w1"
    },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r2",
      "clock": { "boot": "b1", "monoMs": 5, "wallMs": 1000005 }
    },
    {
      "id": "e4",
      "runtime": "R1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r2",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    {
      "id": "e5",
      "runtime": "R2",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    },
    {
      "id": "e6",
      "runtime": "R2",
      "op": "commit",
      "owner": "B",
      "operationId": "w1",
      "sink": "legacy"
    },
    {
      "id": "e7",
      "runtime": "R2",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    }
  ],
  "expect": [
    { "after": "e3", "decision": "legacy" },
    { "after": "e4", "decision": "streams" },
    {
      "after": "e5",
      "decision": "refuse",
      "code": "LEGACY_REFUSED_SWITCHED",
      "status": 426,
      "legacyMutations": 0
    },
    {
      "after": "e6",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503,
      "legacyMutations": 0
    },
    {
      "after": "e7",
      "decision": "refuse",
      "code": "LEGACY_REFUSED_SWITCHED",
      "status": 426,
      "legacyMutations": 0
    }
  ]
}
