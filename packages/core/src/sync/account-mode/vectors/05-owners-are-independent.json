{
  "version": 1,
  "id": "owners-are-independent",
  "description": "A is On, B is Off, A signs in again: each owner keeps its own state.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": {},
  "events": [
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "ra",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "ra",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "B",
      "requestId": "rb",
      "clock": { "boot": "b1", "monoMs": 1, "wallMs": 1000001 }
    },
    {
      "id": "e2",
      "op": "accountResult",
      "authOwner": "B",
      "requestId": "rb",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "B", "state": "off" }
    },
    {
      "id": "f3",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "ra2",
      "clock": { "boot": "b1", "monoMs": 2, "wallMs": 1000002 }
    },
    {
      "id": "e3",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "ra2",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "A", "state": "off" }
    },
    { "id": "e4", "op": "read", "owner": "A" },
    { "id": "e5", "op": "read", "owner": "B" },
    {
      "id": "e6",
      "op": "commit",
      "owner": "B",
      "operationId": "wb",
      "sink": "legacy"
    },
    {
      "id": "e7",
      "op": "commit",
      "owner": "A",
      "operationId": "wa",
      "sink": "legacy"
    }
  ],
  "expect": [
    { "after": "e4", "decision": "streams" },
    { "after": "e5", "decision": "legacy" },
    { "after": "e6", "decision": "legacy", "legacyMutations": 1 },
    {
      "after": "e7",
      "decision": "refuse",
      "code": "LEGACY_REFUSED_SWITCHED",
      "status": 426,
      "legacyMutations": 1
    }
  ]
}
