{
  "version": 1,
  "id": "outage-then-on",
  "description": "Unknown first, then On: no stream answer until the On record is durable, then streams only and no legacy.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": {},
  "events": [
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "timeout",
      "evidence": { "owner": "A", "state": "unknown" }
    },
    { "id": "p1", "op": "pauseDurableSave" },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r2",
      "clock": { "boot": "b1", "monoMs": 10, "wallMs": 1000010 }
    },
    {
      "id": "e2",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r2",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    { "id": "e3", "op": "read", "owner": "A" },
    { "id": "e4", "op": "completeDurableSave" },
    { "id": "e5", "op": "read", "owner": "A" },
    {
      "id": "e6",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    },
    {
      "id": "e7",
      "op": "commit",
      "owner": "A",
      "operationId": "s1",
      "sink": "stream"
    }
  ],
  "expect": [
    {
      "after": "e1",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503
    },
    {
      "after": "e3",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503,
      "durable": { "A": null }
    },
    {
      "after": "e4",
      "of": "e2",
      "decision": "streams",
      "importRequired": false,
      "durable": { "A": { "switched": true } }
    },
    { "after": "e5", "decision": "streams", "importRequired": false },
    {
      "after": "e6",
      "decision": "refuse",
      "code": "LEGACY_REFUSED_SWITCHED",
      "status": 426,
      "legacyMutations": 0
    },
    { "after": "e7", "decision": "streams" }
  ]
}
