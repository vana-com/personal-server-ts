{
  "version": 1,
  "id": "new-owner-first-off",
  "description": "A never-seen owner gets a retryable 503 only until the first Account answer. When that answer is an explicit Off, normal legacy work proceeds with no 503.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": {},
  "events": [
    { "id": "e0", "op": "read", "owner": "A" },
    {
      "id": "e1",
      "op": "commit",
      "owner": "A",
      "operationId": "w0",
      "sink": "legacy"
    },
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e2",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "A", "state": "off" }
    },
    { "id": "e3", "op": "read", "owner": "A" },
    { "id": "e4", "op": "admit", "owner": "A", "operationId": "w1" },
    {
      "id": "e5",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    }
  ],
  "expect": [
    {
      "after": "e0",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503
    },
    {
      "after": "e1",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503,
      "legacyMutations": 0
    },
    { "after": "e2", "decision": "legacy" },
    { "after": "e3", "decision": "legacy" },
    { "after": "e4", "decision": "legacy" },
    { "after": "e5", "decision": "legacy", "legacyMutations": 1 }
  ]
}
