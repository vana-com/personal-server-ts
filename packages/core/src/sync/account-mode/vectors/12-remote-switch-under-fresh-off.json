{
  "version": 1,
  "id": "remote-switch-under-fresh-off",
  "description": "The Account switches on another device while this device holds a fresh Off. Legacy commits are allowed while that Off is fresh (migration-only loss is accepted). At the first On this device observes, the module reports importRequired so the host imports its own legacy files before its first stream run. Only that first On reports it.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": {},
  "events": [
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "A", "state": "off" }
    },
    {
      "id": "e2",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    },
    {
      "id": "e3",
      "op": "clock",
      "clock": { "boot": "b1", "monoMs": 3600000, "wallMs": 4600000 }
    },
    {
      "id": "e4",
      "op": "commit",
      "owner": "A",
      "operationId": "w2",
      "sink": "legacy"
    },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r2",
      "clock": { "boot": "b1", "monoMs": 3600001, "wallMs": 4600001 }
    },
    {
      "id": "e5",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r2",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    {
      "id": "f3",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r3",
      "clock": { "boot": "b1", "monoMs": 3600002, "wallMs": 4600002 }
    },
    {
      "id": "e6",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r3",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    {
      "id": "e7",
      "op": "commit",
      "owner": "A",
      "operationId": "w3",
      "sink": "legacy"
    }
  ],
  "expect": [
    { "after": "e2", "decision": "legacy", "legacyMutations": 1 },
    { "after": "e4", "decision": "legacy", "legacyMutations": 2 },
    { "after": "e5", "decision": "streams", "importRequired": true },
    { "after": "e6", "decision": "streams", "importRequired": false },
    {
      "after": "e7",
      "decision": "refuse",
      "code": "LEGACY_REFUSED_SWITCHED",
      "status": 426,
      "legacyMutations": 2
    }
  ]
}
