{
  "version": 1,
  "id": "on-survives-crash-and-wipe",
  "description": "On is saved outside the data database: it survives a crash before the first commit and a wiped data database.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": { "legacyFiles": ["A"] },
  "events": [
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    {
      "id": "e2",
      "op": "crash",
      "clock": { "boot": "b2", "monoMs": 0, "wallMs": 1000500 }
    },
    { "id": "e3", "op": "wipeDataDb" },
    { "id": "e4", "op": "read", "owner": "A" },
    {
      "id": "e5",
      "op": "commit",
      "owner": "A",
      "operationId": "w1",
      "sink": "legacy"
    },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r2",
      "clock": { "boot": "b2", "monoMs": 50, "wallMs": 1000550 }
    },
    {
      "id": "e6",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r2",
      "rawFixture": "explicit-off",
      "evidence": { "owner": "A", "state": "off" }
    },
    { "id": "e7", "op": "read", "owner": "A" }
  ],
  "expect": [
    {
      "after": "e1",
      "decision": "streams",
      "importRequired": true,
      "durable": { "A": { "switched": true } }
    },
    { "after": "e4", "decision": "streams", "importRequired": false },
    {
      "after": "e5",
      "decision": "refuse",
      "code": "LEGACY_REFUSED_SWITCHED",
      "status": 426,
      "legacyMutations": 0
    },
    { "after": "e7", "decision": "streams" }
  ]
}
