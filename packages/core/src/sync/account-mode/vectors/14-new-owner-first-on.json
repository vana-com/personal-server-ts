{
  "version": 1,
  "id": "new-owner-first-on",
  "description": "A never-seen owner whose first answer is On reaches streams after the save, with importRequired false when the device holds no legacy files, and true when it does.",
  "policy": { "offTtlMs": 604800000 },
  "owners": {
    "A": "0x1111111111111111111111111111111111111111",
    "B": "0x2222222222222222222222222222222222222222",
    "C": "0x3333333333333333333333333333333333333333",
    "D": "0x4444444444444444444444444444444444444444",
    "E": "0x5555555555555555555555555555555555555555",
    "F": "0x6666666666666666666666666666666666666666"
  },
  "initial": { "legacyFiles": ["B"] },
  "events": [
    { "id": "e0", "op": "read", "owner": "A" },
    {
      "id": "f1",
      "op": "fetchStart",
      "owner": "A",
      "requestId": "r1",
      "clock": { "boot": "b1", "monoMs": 0, "wallMs": 1000000 }
    },
    {
      "id": "e1",
      "op": "accountResult",
      "authOwner": "A",
      "requestId": "r1",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "A", "state": "on" }
    },
    { "id": "e2", "op": "read", "owner": "A" },
    {
      "id": "e3",
      "op": "commit",
      "owner": "A",
      "operationId": "s1",
      "sink": "stream"
    },
    {
      "id": "f2",
      "op": "fetchStart",
      "owner": "B",
      "requestId": "r2",
      "clock": { "boot": "b1", "monoMs": 1, "wallMs": 1000001 }
    },
    {
      "id": "e4",
      "op": "accountResult",
      "authOwner": "B",
      "requestId": "r2",
      "rawFixture": "explicit-on",
      "evidence": { "owner": "B", "state": "on" }
    }
  ],
  "expect": [
    {
      "after": "e0",
      "decision": "refuse",
      "code": "ACCOUNT_MODE_UNKNOWN",
      "status": 503
    },
    {
      "after": "e1",
      "decision": "streams",
      "importRequired": false,
      "durable": { "A": { "switched": true } }
    },
    { "after": "e2", "decision": "streams", "importRequired": false },
    { "after": "e3", "decision": "streams" },
    { "after": "e4", "decision": "streams", "importRequired": true }
  ]
}
