{
	"protocol_version": "0.1.0",
	"connector_id": "https://registry.pdpp.dev/connectors/anthropic",
	"connector_key": "anthropic",
	"manifest_uri": "https://registry.pdpp.dev/connectors/anthropic",
	"version": "0.1.3",
	"display_name": "Claude (Anthropic)",
	"brand": {
		"icon": "icon.svg",
		"background_color": "#D97757"
	},
	"runtime_requirements": {
		"bindings": {
			"network": {
				"required": true
			},
			"browser": {
				"required": true
			}
		}
	},
	"capabilities": {
		"human_interaction": ["manual_action"],
		"refresh_policy": {
			"recommended_mode": "manual",
			"minimum_interval_seconds": 3600,
			"interaction_posture": "manual_action_likely",
			"rate_limit_sensitivity": "medium",
			"bot_detection_sensitivity": "high",
			"background_safe": false,
			"rationale": "Claude.ai conversations are browser-scraped behind a login wall; background polling risks lockouts."
		},
		"public_listing": {
			"tier": "development"
		}
	},
	"streams": [
		{
			"name": "account_profile",
			"description": "Claude account profile name, browser plan label, and export organization.",
			"required": false,
			"display": {
				"label": "Your Claude account",
				"detail": "Account display name, plan label, and export organization identity."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
					"organization_id": { "type": "string" },
					"full_name": { "type": ["string", "null"], "x_pdpp_role": "primary-title" },
					"plan": { "type": ["string", "null"] },
					"name_source": { "type": "string", "enum": ["browser_menu", "users_json", "none"] },
					"metadata_status": { "type": "string", "enum": ["valid", "absent", "malformed", "ambiguous", "mismatch"] }
				},
				"required": ["id", "organization_id", "full_name", "plan", "name_source", "metadata_status"]
			},
			"primary_key": ["id"],
			"query": { "search": { "lexical_fields": ["full_name"] } },
			"selection": { "fields": true, "resources": false },
			"incremental": false,
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "conversations",
			"description": "Claude.ai conversations.",
			"required": false,
			"display": {
				"label": "Your Claude conversations",
				"detail": "Conversation titles, create/update times, project membership, message counts."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"title": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"create_time": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"update_time": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"project_id": {
						"type": ["string", "null"]
					},
					"model": {
						"type": ["string", "null"]
					},
					"message_count": {
						"type": ["integer", "null"]
					},
					"is_starred": {
						"type": ["boolean", "null"]
					}
				},
				"required": ["id"]
			},
			"primary_key": ["id"],
			"consent_time_field": "create_time",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["title"],
					"semantic_fields": ["title"]
				},
				"range_filters": {
					"create_time": ["gte", "gt", "lte", "lt"],
					"update_time": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["create_time"]
				}
			},
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "messages",
			"description": "Messages within Claude conversations.",
			"required": false,
			"display": {
				"label": "Your Claude messages",
				"detail": "Role, content, model, creation time, per-conversation ordering."
			},
			"semantics": "append_only",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"conversation_id": {
						"type": "string"
					},
					"role": {
						"type": ["string", "null"],
						"x_pdpp_role": "actor"
					},
					"parent_id": {
						"type": ["string", "null"]
					},
					"content": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"model": {
						"type": ["string", "null"]
					},
					"create_time": {
						"type": ["string", "null"],
						"format": "date-time",
						"x_pdpp_role": "event-time"
					},
					"update_time": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"attachments": {
						"type": ["array", "null"],
						"items": {
							"type": "object"
						}
					}
				},
				"required": ["id", "conversation_id"]
			},
			"primary_key": ["id"],
			"consent_time_field": "create_time",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"relationships": [
				{
					"name": "conversation",
					"stream": "conversations",
					"foreign_key": "conversation_id",
					"cardinality": "has_one"
				}
			],
			"query": {
				"search": {
					"lexical_fields": ["content"],
					"semantic_fields": ["content"]
				},
				"range_filters": {
					"create_time": ["gte", "gt", "lte", "lt"],
					"update_time": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["create_time"]
				}
			},
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "projects",
			"description": "Claude Projects the user has created.",
			"required": false,
			"display": {
				"label": "Your Claude projects",
				"detail": "Project names, descriptions, create times, associated conversation counts."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string",
						"x_pdpp_role": "primary-title"
					},
					"description": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"create_time": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"update_time": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"is_archived": {
						"type": ["boolean", "null"]
					},
					"prompt_template": {
						"type": ["string", "null"]
					},
					"creator": {
						"type": ["object", "null"],
						"properties": {
							"uuid": { "type": "string" },
							"full_name": { "type": "string" }
						},
						"additionalProperties": false
					},
					"is_private": { "type": ["boolean", "null"] },
					"is_starter_project": { "type": ["boolean", "null"] },
					"archived_at": { "type": ["string", "null"] },
					"raw_docs": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"uuid": { "type": "string" },
								"filename": { "type": "string" },
								"content": { "type": "string" },
								"created_at": { "type": "string" },
								"updated_at": { "type": "string" }
							},
							"additionalProperties": false
						}
					}
				},
				"required": ["id", "name"]
			},
			"primary_key": ["id"],
			"consent_time_field": "create_time",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["name", "description"],
					"semantic_fields": ["description"]
				},
				"range_filters": {
					"create_time": ["gte", "gt", "lte", "lt"],
					"update_time": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["create_time"]
				}
			},
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "project_documents",
			"description": "Documents attached to Claude Projects (project knowledge files).",
			"required": false,
			"display": {
				"label": "Your Claude project documents",
				"detail": "Filenames and content of documents attached to your Claude projects."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"project_id": {
						"type": "string"
					},
					"filename": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"content": {
						"type": ["string", "null"]
					},
					"create_time": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"update_time": {
						"type": ["string", "null"],
						"format": "date-time"
					}
				},
				"required": ["id", "project_id"]
			},
			"primary_key": ["id"],
			"consent_time_field": "create_time",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"relationships": [
				{
					"name": "project",
					"stream": "projects",
					"foreign_key": "project_id",
					"cardinality": "has_one"
				}
			],
			"query": {
				"search": {
					"lexical_fields": ["filename", "content"],
					"semantic_fields": ["content"]
				},
				"range_filters": {
					"create_time": ["gte", "gt", "lte", "lt"],
					"update_time": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["create_time"]
				}
			},
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		}
	],
	"reason_display_messages": {
		"export_pending": "Claude is still preparing your data export. This will finish automatically on a later run.",
		"no_chat_organization": "No Claude organization with chat access could be found for this account.",
		"export_request_failed": "Claude couldn't start preparing your data export. This will retry automatically.",
		"export_part_download_failed": "Part of your Claude data export could not be downloaded (the link may have already been used or expired). A new export will be requested automatically."
	}
}
