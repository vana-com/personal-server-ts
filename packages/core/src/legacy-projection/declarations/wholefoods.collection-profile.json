{
	"protocol_version": "0.1.0",
	"connector_id": "https://registry.pdpp.dev/connectors/wholefoods",
	"connector_key": "wholefoods",
	"manifest_uri": "https://registry.pdpp.dev/connectors/wholefoods",
	"version": "0.3.0",
	"display_name": "Whole Foods",
	"runtime_requirements": {
		"bindings": {
			"network": {
				"required": true
			},
			"browser": {
				"required": true
			}
		}
	},
	"setup": {
		"modality": "static_secret",
		"credential_capture": {
			"kind": "api_key",
			"label": "USDA FoodData Central API key (optional)",
			"description": "Optional. A free USDA FoodData Central API key improves nutrition-lookup coverage and rate limits for products the Whole Foods product page does not have nutrition facts for. Leave blank to use the public rate-limited DEMO_KEY.",
			"submit_label": "Save USDA API key",
			"fields": [
				{
					"name": "usda_api_key",
					"label": "USDA FoodData Central API key",
					"type": "password",
					"required": false,
					"secret": true,
					"autocomplete": "off",
					"help_url": "https://fdc.nal.usda.gov/api-key-signup",
					"help_text": "Get a free key at https://fdc.nal.usda.gov/api-key-signup. Without one, nutrition lookups use the shared DEMO_KEY, which is more rate-limited.",
					"env": ["USDA_API_KEY"]
				}
			]
		}
	},
	"capabilities": {
		"human_interaction": ["manual_action", "otp"],
		"refresh_policy": {
			"recommended_mode": "manual",
			"minimum_interval_seconds": 7200,
			"interaction_posture": "otp_likely",
			"rate_limit_sensitivity": "medium",
			"bot_detection_sensitivity": "high",
			"background_safe": false,
			"rationale": "Whole Foods (via Amazon) frequently requires OTP and triggers bot-detection; refresh manually."
		},
		"public_listing": {
			"tier": "development"
		}
	},
	"streams": [
		{
			"name": "profile",
			"required": false,
			"description": "The Amazon account used to place Whole Foods orders.",
			"display": {
				"label": "Your Amazon account",
				"detail": "Name and email of the Amazon account whose order history was scraped."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"email": {
						"type": ["string", "null"]
					}
				},
				"required": ["id"]
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["name"]
				}
			},
			"coverage_strategy": "singleton_presence",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "orders",
			"required": true,
			"description": "Whole Foods orders via Amazon.",
			"display": {
				"label": "Your Whole Foods orders",
				"detail": "Order date, order URL, total, item count, status. Uses your Amazon login."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"order_date": {
						"type": ["string", "null"],
						"format": "date",
						"x_pdpp_role": "event-time"
					},
					"order_url": {
						"type": ["string", "null"],
						"format": "uri"
					},
					"status": {
						"type": ["string", "null"]
					},
					"total_cents": {
						"type": ["integer", "null"]
					},
					"item_count": {
						"type": "integer"
					}
				},
				"required": ["id", "item_count"]
			},
			"primary_key": ["id"],
			"consent_time_field": "order_date",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"query": {
				"range_filters": {
					"order_date": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["order_date"]
				}
			},
			"coverage_strategy": "checkpoint_window",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "order_items",
			"required": true,
			"description": "Items within Whole Foods orders, each with a source Amazon product ID. Nutrition joins on `product_id`.",
			"display": {
				"label": "Your Whole Foods items",
				"detail": "Product name, quantity, price."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"order_id": {
						"type": "string"
					},
					"name": {
						"type": "string",
						"x_pdpp_role": "primary-title"
					},
					"product_id": {
						"type": "string"
					},
					"product_url": {
						"type": ["string", "null"],
						"format": "uri"
					},
					"image_url": {
						"type": ["string", "null"]
					},
					"quantity": {
						"type": ["number", "null"]
					},
					"unit_price_cents": {
						"type": ["integer", "null"]
					}
				},
				"required": ["id", "order_id", "name", "product_id"]
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["name"]
				}
			},
			"coverage_strategy": "parent_detail_accounting",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "nutrition",
			"required": false,
			"description": "Nutrition facts or observed lookup outcome per unique product. Sources are the Whole Foods product page and USDA FoodData Central. Joins to `order_items` on `product_id`.",
			"display": {
				"label": "Nutrition facts",
				"detail": "Nutrition facts when found, or a not found, blocked, or error outcome when lookup fails."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"product_id": {
						"type": "string"
					},
					"name": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"source": {
						"type": "string",
						"enum": [
							"wholefoods_product_page",
							"usda_fdc",
							"not_found",
							"error",
							"blocked"
						]
					},
					"confidence": {
						"type": "string",
						"enum": ["high", "medium", "low"]
					},
					"calories": {
						"type": ["number", "null"]
					},
					"protein_g": {
						"type": ["number", "null"]
					},
					"carbs_g": {
						"type": ["number", "null"]
					},
					"fat_g": {
						"type": ["number", "null"]
					},
					"sodium_mg": {
						"type": ["number", "null"]
					},
					"fiber_g": {
						"type": ["number", "null"]
					},
					"sugar_g": {
						"type": ["number", "null"]
					},
					"serving_size": {
						"type": ["string", "null"]
					},
					"servings_per_container": {
						"type": ["number", "null"]
					}
				},
				"required": ["product_id", "source", "confidence"]
			},
			"primary_key": ["product_id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"query": {
				"search": {
					"lexical_fields": ["name"]
				}
			},
			"coverage_strategy": "parent_detail_accounting",
			"freshness_strategy": "manual_as_of"
		}
	],
	"reason_display_messages": {
		"wholefoods_filter_pending": "Whole Foods filter support isn't wired up yet"
	}
}
