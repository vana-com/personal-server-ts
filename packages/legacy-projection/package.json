{
  "name": "@opendatalabs/personal-server-ts-legacy-projection",
  "version": "0.0.1",
  "description": "Pure projection of PDPP records to the legacy Vana scope bodies existing apps read",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vana-com/personal-server-ts.git",
    "directory": "packages/legacy-projection"
  },
  "homepage": "https://github.com/vana-com/personal-server-ts#readme",
  "bugs": {
    "url": "https://github.com/vana-com/personal-server-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy-schemas/*.json": "./dist/legacy-schemas/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "copy-schemas": "mkdir -p dist/legacy-schemas && cp src/legacy-schemas/*.json dist/legacy-schemas/",
    "build": "tsc --build && npm run copy-schemas"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
