{
  "name": "@opendatalabs/personal-server-ts-lite",
  "version": "0.0.1",
  "description": "Browser/WebView Personal Server Lite runtime boundary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vana-com/personal-server-ts.git",
    "directory": "packages/lite"
  },
  "homepage": "https://github.com/vana-com/personal-server-ts#readme",
  "bugs": {
    "url": "https://github.com/vana-com/personal-server-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./additions-worker": "./dist/additions-worker.bundle.js",
    "./import-job": {
      "types": "./dist/import-job.d.ts",
      "import": "./dist/import-job.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "copy-tls": "mkdir -p dist/browser-tls-rustls && cp src/browser-tls-rustls/* dist/browser-tls-rustls/",
    "build": "tsc --build && npm run copy-tls && npm run build-worker",
    "build-worker": "esbuild src/additions-worker.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/additions-worker.bundle.js"
  },
  "dependencies": {
    "@opendatalabs/personal-server-ts-core": "*",
    "@opendatalabs/vana-sdk": "3.23.0-pr.211.36da1d8",
    "node-forge": "^1.4.0",
    "viem": "^2.54.2",
    "openpgp": "6.3.0"
  }
}
