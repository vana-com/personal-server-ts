            "hash": "ab7e4f03bf76dae7854a5f41f44c7c6c0af8fc139760aab1d74d738d2283b2d7",
            "recordCount": 1
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "observation times count toward the part size",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1730851200000
        },
        {
          "record": {
            "id": 2
          },
          "observedAt": 1730851200000
