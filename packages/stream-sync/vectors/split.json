      "partSizeBytes": 51,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1730851200000],\"records\":[{\"id\":1}]}",
            "bytes": 51,
            "hash": "40dc47919cbce2736a4d9cad27f113a8f776777c58fff61c3f66a45201d8eb1c",
            "recordCount": 1
          },
          {
            "text": "{\"observedAt\":[1730851200000],\"records\":[{\"id\":2}]}",
            "bytes": 51,
            "hash": "9a242fe1df92e02d01feba2adacbe006b71cf570df58428d7e72d811de5ccc53",
            "recordCount": 1
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "each record keeps its own observation time",
