{
  "vectorVersion": 1,
  "kind": "split",
  "cases": [
    {
      "name": "empty input gives no parts",
      "records": [],
      "partSizeBytes": 100,
      "expected": {
        "parts": [],
        "warnings": []
      }
    },
    {
      "name": "one part under the limit",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1
        },
        {
          "record": {
            "id": 2
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 1000,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1,1],\"records\":[{\"id\":1},{\"id\":2}]}",
            "bytes": 50,
            "hash": "a36ccd006f752520a4891c63a7e42cb302f6c799b56bdc2a925d61cbb5fac3ae",
            "recordCount": 2
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "a part exactly at the limit is allowed (50 bytes)",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1
        },
        {
          "record": {
            "id": 2
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 50,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1,1],\"records\":[{\"id\":1},{\"id\":2}]}",
            "bytes": 50,
            "hash": "a36ccd006f752520a4891c63a7e42cb302f6c799b56bdc2a925d61cbb5fac3ae",
            "recordCount": 2
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "one byte under the limit forces a split",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1
        },
        {
          "record": {
            "id": 2
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 49,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"id\":1}]}",
            "bytes": 39,
            "hash": "795bb38d65e1722cc08cca3264f94c0b924cc540d8d6b50302db96f21c3dffde",
            "recordCount": 1
          },
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"id\":2}]}",
            "bytes": 39,
            "hash": "ec2a9d9c5a7877660108f98f12184c74749035af71b8d680113deb48e71ce5e4",
            "recordCount": 1
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "a single record exactly at the limit (39 bytes) has no warning",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 39,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"id\":1}]}",
            "bytes": 39,
            "hash": "795bb38d65e1722cc08cca3264f94c0b924cc540d8d6b50302db96f21c3dffde",
            "recordCount": 1
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "a single record one byte over the limit gets its own part and a warning",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 38,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"id\":1}]}",
            "bytes": 39,
            "hash": "795bb38d65e1722cc08cca3264f94c0b924cc540d8d6b50302db96f21c3dffde",
            "recordCount": 1
          }
        ],
        "warnings": [
          {
            "code": "oversized-record",
            "partIndex": 0,
            "partBytes": 39,
            "limit": 38
          }
        ]
      }
    },
    {
      "name": "an oversized record sits alone between normal parts",
      "records": [
        {
          "record": {
            "id": 1
          },
          "observedAt": 1
        },
        {
          "record": {
            "big": "xxxxxxxxxxxxxxxxxxxx"
          },
          "observedAt": 1
        },
        {
          "record": {
            "id": 3
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 60,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"id\":1}]}",
            "bytes": 39,
            "hash": "795bb38d65e1722cc08cca3264f94c0b924cc540d8d6b50302db96f21c3dffde",
            "recordCount": 1
          },
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"big\":\"xxxxxxxxxxxxxxxxxxxx\"}]}",
            "bytes": 61,
            "hash": "a1f1809b3dec29f7c9128531d2e90da0f8c4db1c385a2d2300bb6bcd8d182e70",
            "recordCount": 1
          },
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"id\":3}]}",
            "bytes": 39,
            "hash": "c36cd8c084645b5f05e5a8f2b5393eab0e44ec4cf53e395be6d60879a3ff2d45",
            "recordCount": 1
          }
        ],
        "warnings": [
          {
            "code": "oversized-record",
            "partIndex": 1,
            "partBytes": 61,
            "limit": 60
          }
        ]
      }
    },
    {
      "name": "record fields are written in sorted order",
      "records": [
        {
          "record": {
            "b": 1,
            "a": 2
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 1000,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"a\":2,\"b\":1}]}",
            "bytes": 44,
            "hash": "4abe1da484d0e00a88f85d406d3c1b6335b1dc04d935ad4a78d52db9144f917c",
            "recordCount": 1
          }
        ],
        "warnings": []
      }
    },
    {
      "name": "sizes count UTF-8 bytes, not characters",
      "records": [
        {
          "record": {
            "n": "é😀"
          },
          "observedAt": 1
        }
      ],
      "partSizeBytes": 1000,
      "expected": {
        "parts": [
          {
            "text": "{\"observedAt\":[1],\"records\":[{\"n\":\"é😀\"}]}",
