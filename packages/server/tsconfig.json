{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-utils.ts",
    "src/**/*.workload.ts",
    "src/**/*.harness.ts"
  ],
  "references": [
    { "path": "../core" },
    { "path": "../lite" },
    { "path": "../stream-sync" }
  ]
}
